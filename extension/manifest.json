{
  "manifest_version": 3,
  "name": "CointMU Wallet",
  "version": "1.0.1",
  "description": "Connects dApps to the CointMU desktop wallet via a local WebSocket relay.",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:8546/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
